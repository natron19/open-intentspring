<% script = @guided_script %>
<div data-controller="download-markdown"
     data-download-markdown-content-value="<%= script.completed? ? script.to_markdown : '' %>"
     data-download-markdown-filename-value="<%= script.markdown_filename %>"
     style="max-width: 820px;">

  <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-3">
    <div>
      <p class="text-muted small mb-1">Guided script</p>
      <h1 class="h3 mb-1"><%= script.completed? ? script.title : "Your script" %></h1>
      <p class="text-muted small mb-0">
        <%= link_to "← My intentions", intentions_path, class: "text-muted" %>
        &nbsp;&middot;&nbsp;
        <%= link_to "The intention", intention_path(@intention), class: "text-muted" %>
        &nbsp;&middot;&nbsp;
        Written <%= script.generated_at ? "#{time_ago_in_words(script.generated_at)} ago" : "at an unknown time" %>
      </p>
    </div>
    <div class="d-flex flex-wrap gap-2 align-items-start">
      <%= render "intentions/write_button", intention: @intention, label: "Write another",
                 button_class: "btn btn-outline-secondary btn-sm" %>
      <% if script.completed? %>
        <button class="btn btn-outline-primary btn-sm" type="button"
                data-action="click->download-markdown#download">
          Download .md
        </button>
      <% end %>
      <button class="btn btn-outline-secondary btn-sm" type="button"
              data-bs-toggle="collapse" data-bs-target="#raw-response"
              aria-expanded="false" aria-controls="raw-response">
        Show raw response
      </button>
    </div>
  </div>

  <p class="text-muted small mb-3">
    <strong>AI-generated.</strong> A script for you to read aloud or record yourself. It is not therapy or medical
    advice, and it can be wrong. Change anything that does not sound like you.
  </p>

  <% if script.stale? %>
    <div class="alert alert-warning py-2 small">
      Your intention has changed since this script was written. Write another to use the new version.
    </div>
  <% end %>

  <% if script.failed? %>
    <%= render "guided_scripts/parse_error", intention: @intention, script: script %>
  <% elsif script.completed? %>
    <blockquote class="intention-quote mb-2"><%= @intention.sentence %></blockquote>
    <p class="text-muted small mb-4">
      <%= Intention.length_label(script.length_minutes) %> &middot; <%= @intention.tone %> &middot;
      <%= script.word_count %> words &middot; <%= script.total_pause_seconds %> seconds of pauses
    </p>

    <div class="script mb-4">
      <% script.segments.each do |segment| %>
        <p class="script-text"><%= segment["text"] %></p>
        <% if segment["pause_seconds"].to_i.positive? %>
          <p class="script-pause">[pause, <%= segment["pause_seconds"] %> seconds]</p>
        <% end %>
      <% end %>
    </div>

    <div class="card making-card mb-4">
      <div class="card-body">
        <h2 class="h5 mb-3">Something to make afterwards</h2>
        <dl class="row mb-2 small">
          <dt class="col-sm-3 text-muted">Form</dt>
          <dd class="col-sm-9 text-capitalize"><%= script.form_label %></dd>
          <dt class="col-sm-3 text-muted">Constraint</dt>
          <dd class="col-sm-9"><%= script.making_prompt["constraint"] %></dd>
        </dl>
        <p class="mb-0"><%= script.making_prompt["invitation"] %></p>
      </div>
    </div>
  <% else %>
    <p class="text-muted fst-italic">This script is still being written&hellip;</p>
  <% end %>

  <div class="collapse mt-3" id="raw-response">
    <div class="card card-body">
      <p class="text-muted small mb-1">Raw response from Gemini:</p>
      <pre class="small mb-0 text-muted"><%= script.gemini_raw %></pre>
    </div>
  </div>
</div>
