<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0">My intentions</h1>
  <%= link_to "New intention", new_intention_path, class: "btn btn-primary btn-sm" %>
</div>

<% if @intentions.empty? %>
  <div class="text-center py-5">
    <p class="text-muted mb-3">You haven&rsquo;t named anything yet.</p>
    <%= link_to "Name your first intention", new_intention_path, class: "btn btn-primary" %>
  </div>
<% else %>
  <div class="row g-3">
    <% @intentions.each do |intention| %>
      <% script = intention.latest_guided_script %>
      <div class="col-12">
        <%= link_to intention_path(intention), class: "text-decoration-none" do %>
          <div class="card card-hover">
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-start gap-3">
                <div>
                  <p class="intention-sentence mb-1 text-body"><%= intention.sentence %></p>
                  <p class="text-muted small mb-0"><%= intention.length_label %> &middot; <%= intention.tone %></p>
                </div>
                <div class="text-end small flex-shrink-0">
                  <% if script&.completed? %>
                    <div class="text-body"><%= script.title %></div>
                    <div class="text-muted">written <%= time_ago_in_words(script.generated_at) %> ago</div>
                  <% elsif script&.failed? %>
                    <div class="text-muted fst-italic">last script could not be used</div>
                  <% else %>
                    <div class="text-muted fst-italic">no script yet</div>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
