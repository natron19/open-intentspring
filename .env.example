# ── App Branding ───────────────────────────────────────────────────────────────
APP_NAME="IntentSpring Demo"
APP_TAGLINE="One sentence you're reaching for in. A guided script out."
APP_DESCRIPTION="An open source, single-feature demo of IntentSpring."

# ── Database ───────────────────────────────────────────────────────────────────
# DATABASE_URL=postgres://localhost/open_intentspring_development  # optional override

# ── Google Gemini ──────────────────────────────────────────────────────────────
# Get your free API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── AI Operational Limits ──────────────────────────────────────────────────────
AI_CALLS_PER_USER_PER_DAY=50
# A ten-minute script is about 1,600 words; gemini-2.5-flash needs more than the base 15 seconds for it.
AI_GLOBAL_TIMEOUT_SECONDS=45
AI_THINKING_BUDGET=1024          # gemini-2.5 thinking tokens per call, on top of each template's max_output_tokens (-1 = Gemini decides)
